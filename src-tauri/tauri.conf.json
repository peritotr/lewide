{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LewIDE",
  "version": "0.2.1",
  "identifier": "io.github.peritotr.lewide",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LewIDE",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      },
      {
        "label": "splash",
        "title": "LewIDE",
        "url": "splash.html",
        "width": 480,
        "height": 300,
        "decorations": false,
        "resizable": false,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "LewIDE contributors",
    "copyright": "Copyright (c) 2026 LewIDE contributors. MIT OR Apache-2.0.",
    "homepage": "https://github.com/peritotr/lewide",
    "category": "DeveloperTool",
    "shortDescription": "An open-source desktop client for every database",
    "longDescription": "LewIDE opens relational, document, key-value, vector and graph databases in one desktop app, with a SQL editor, a data grid, structure views, import and export, and an AI assistant that sees only the schema.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
